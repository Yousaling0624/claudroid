[Unit]
Description=claudroid-bridge 主机守护进程
Documentation=https://github.com/Yousaling0624/claudroid/tree/main/bridge
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/bin/claudroid-bridge start
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target
